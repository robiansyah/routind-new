{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "bepsvpt/secure-headers": "^9.1",
        "cjmellor/level-up": "^1.5",
        "guzzlehttp/guzzle": "^7.2",
        "haruncpi/laravel-id-generator": "^1.1",
        "iio/libmergepdf": "^4.0",
        "laravel/framework": "^12.0",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.20",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "laravolt/avatar": "~6.4.0",
        "maatwebsite/excel": "^3.1.64",
        "mews/captcha": "^3.4",
        "milon/barcode": "^12.0",
        "nextapps/laravel-verification-code": "^3.1",
        "opcodesio/log-viewer": "^3.19",
        "predis/predis": "^3.4",
        "riskihajar/terbilang": "^2.1",
        "simplesoftwareio/simple-qrcode": "~4",
        "tianrosandhy/laravel-fonnte": "@dev",
        "tymon/jwt-auth": "^2.2",
        "xendit/xendit-php": "^5.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
